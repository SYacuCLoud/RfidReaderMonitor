<UserControl x:Class="RfidReaderMonitor.Views.AcsToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:RfidReaderMonitor.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AcsToolsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10"
                       Text="ACS(Advanced Card Systems) 리더 전용 기능입니다. PC/SC 표준이 아닌 CCID 에스케이프 명령을 쓰므로 다른 제조사 리더에서는 동작하지 않습니다. 명령을 보내려면 ACS 드라이버의 EscapeCommandEnable 레지스트리 값이 필요합니다."/>

            <TextBlock Text="{Binding Reader.DisplayName, StringFormat='대상 리더: {0}'}" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <GroupBox Header="에스케이프 명령 허용 (드라이버 레지스트리)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="EscapeCommandEnable: " Style="{DynamicResource Label}"/>
                    <TextBlock Text="{Binding Reader.EscapeText}" Style="{DynamicResource Value}" FontWeight="SemiBold"/>
                    <Button Content="레지스트리 설정 (관리자)" Margin="12,0,0,0" Command="{Binding EnableEscapeCommand}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="조회 / 제어">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="펌웨어/S/N 조회" Command="{Binding ReadFirmwareCommand}"/>
                        <Button Content="부저" Command="{Binding BeepCommand}"/>
                        <Button Content="LED ON" Command="{Binding LedOnCommand}"/>
                        <Button Content="LED OFF" Command="{Binding LedOffCommand}"/>
                        <Button Content="폴링/파라미터 조회" Command="{Binding ReadPollingCommand}"/>
                    </WrapPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="펌웨어" Style="{DynamicResource Label}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Reader.Firmware}" Style="{DynamicResource Value}"/>
                        <TextBlock Grid.Row="1" Text="자동 폴링" Style="{DynamicResource Label}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Reader.PollingText}" Style="{DynamicResource Value}"/>
                        <TextBlock Grid.Row="2" Text="PICC 파라미터" Style="{DynamicResource Label}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Reader.PiccParamText}" Style="{DynamicResource Value}"/>
                        <TextBlock Grid.Row="3" Text="LED/부저 기본" Style="{DynamicResource Label}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Reader.LedBuzzerText}" Style="{DynamicResource Value}"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="자동 폴링 설정">
                <WrapPanel>
                    <CheckBox Content="자동 폴링 ON" IsChecked="{Binding PollEnable}" Margin="0,0,12,0"/>
                    <TextBlock Text="주기" Style="{DynamicResource Label}"/>
                    <ComboBox SelectedItem="{Binding PollIntervalMs}" Width="90" Margin="0,0,12,0">
                        <sys:Int32>250</sys:Int32>
                        <sys:Int32>500</sys:Int32>
                        <sys:Int32>1000</sys:Int32>
                        <sys:Int32>2500</sys:Int32>
                    </ComboBox>
                    <CheckBox Content="태그 없으면 안테나 OFF" IsChecked="{Binding PollAntennaOffIfNoPicc}" Margin="0,0,12,0"/>
                    <CheckBox Content="감지 시 PICC 활성화" IsChecked="{Binding PollActivateOnDetect}" Margin="0,0,12,0"/>
                    <Button Content="폴링 설정 적용" Command="{Binding ApplyPollingCommand}"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="직접 명령">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="명령 (hex)" Style="{DynamicResource Label}"/>
                    <TextBox Grid.Column="1" Text="{Binding CustomEscapeHex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Margin="0,2"/>
                    <Button Grid.Column="2" Content="전송" Margin="8,0,0,0" Command="{Binding SendCustomEscapeCommand}"/>
                    <TextBlock Grid.Row="1" Text="응답" Style="{DynamicResource Label}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CustomEscapeResponse, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,2" TextWrapping="Wrap"/>
                </Grid>
            </GroupBox>

            <TextBlock Text="{Binding Reader.LastError}" Foreground="#B03A2E" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
