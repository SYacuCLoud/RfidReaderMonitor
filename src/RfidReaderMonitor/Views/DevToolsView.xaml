<UserControl x:Class="RfidReaderMonitor.Views.DevToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RfidReaderMonitor.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DevToolsViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="산업용 리더가 없을 때 Modbus TCP 입력 경로를 시험하는 가짜 리더입니다. 아래 시뮬레이터를 켜고 '리더 등록…' 으로 127.0.0.1 리더를 등록하면 이 앱의 Modbus 프로바이더가 여기에 붙습니다. 태그를 놓고 빼면 PC/SC 리더와 똑같이 등장/제거 이벤트가 나옵니다."/>

            <GroupBox Header="Modbus TCP 리더 시뮬레이터">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="포트" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SimPort}" Width="70" Margin="0,0,10,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SimRunning}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <Button Content="{Binding SimButtonText}" Command="{Binding ToggleSimCommand}" MinWidth="120" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding SimStatusText}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="레지스터 맵 (0 기준 주소, Holding 과 Input 은 같은 값)" Style="{StaticResource Head}" Margin="0,8,0,2"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                            <TextBlock Text="Present 비트 (Coil/DI) 주소" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PresentBitAddress}" Width="50"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                            <TextBlock Text="Present 레지스터 주소" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PresentRegisterAddress}" Width="50" Margin="0,0,6,0"/>
                            <TextBlock Text="비트" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PresentRegisterBit}" Width="36"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,16,2">
                            <TextBlock Text="UID 레지스터 주소" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding UidAddress}" Width="50" Margin="0,0,6,0"/>
                            <TextBlock Text="바이트" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding UidBytes}" Width="36"/>
                        </StackPanel>
                        <CheckBox Content="워드 안 바이트 스왑" IsChecked="{Binding SwapBytes}" Margin="0,2,12,2" VerticalAlignment="Center"/>
                        <CheckBox Content="워드 역순" IsChecked="{Binding ReverseWords}" Margin="0,2,12,2" VerticalAlignment="Center"/>
                    </WrapPanel>

                    <TextBlock Text="태그" Style="{StaticResource Head}" Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button Content="{Binding TagButtonText}" Command="{Binding ToggleTagCommand}" MinWidth="110" Height="34" FontSize="14" FontWeight="SemiBold" Margin="0,0,12,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TagPresent}" Value="True">
                                            <Setter Property="Background" Value="#DFF5E1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Text="UID (hex)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding UidHex, UpdateSourceTrigger=PropertyChanged}" Width="240" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="무작위 UID" Command="{Binding RandomUidCommand}" MinWidth="80" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding UidError}" Foreground="#B03A2E" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <CheckBox Content="자동으로 놓기/빼기 반복, 주기(ms)" IsChecked="{Binding AutoToggle}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding AutoPeriodMs}" Width="60" Margin="0,0,12,0"/>
                        <CheckBox Content="반복마다 UID 바꾸기" IsChecked="{Binding AutoChangeUid}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="이 앱에 리더로 등록" Style="{StaticResource Head}" Margin="0,8,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button Content="리더 등록… (Present = Discrete Input)" Command="{Binding AddReaderRowDiscreteCommand}" Margin="0,0,8,0"/>
                        <Button Content="리더 등록… (Present = 레지스터 비트)" Command="{Binding AddReaderRowRegisterCommand}" Margin="0,0,8,0"/>
                        <TextBlock Text="등록 대화상자가 시뮬레이터 값으로 채워져 열립니다. 확인을 누르면 바로 접속합니다." Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="시뮬레이터 로그" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="지우기" Command="{Binding ClearLogCommand}" HorizontalAlignment="Right" MinWidth="60" Margin="0,0,0,4"/>
                <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="11.5" BorderThickness="0"/>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>
