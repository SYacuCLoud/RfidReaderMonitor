<Window x:Class="RfidReaderMonitor.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RfidReaderMonitor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UpdateViewModel}"
        Title="업데이트" Width="560" Height="460" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        FontFamily="Malgun Gothic" FontSize="12.5" Background="#F4F5F7" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="새 버전이 있습니다" FontSize="17" FontWeight="Bold" Foreground="#222"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
            <TextBlock Text="{Binding CurrentText}" FontSize="20" FontFamily="Consolas" Foreground="#888" VerticalAlignment="Center"/>
            <TextBlock Text="  →  " FontSize="20" Foreground="#888" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding NewText}" FontSize="20" FontFamily="Consolas" FontWeight="Bold" Foreground="#1B2A41" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SizeText, StringFormat='   {0}'}" Foreground="#666" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding PublishedText, StringFormat='   {0}'}" Foreground="#888" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#D8DBE0" BorderThickness="1" CornerRadius="4" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding Notes, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"/>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar Height="14" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}"
                         Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding ProgressText}" Foreground="#444" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Error}" Foreground="#B03A2E" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                   Text="지금 업데이트를 누르면 새 실행 파일을 내려받아 sha256 으로 검증한 뒤 프로그램을 종료하고 교체 후 같은 설정으로 다시 시작합니다. 설정·별명·로그는 그대로 유지됩니다."/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="릴리스 페이지" Command="{Binding OpenReleasePageCommand}"/>
            <Button Content="나중에" Command="{Binding CancelCommand}"/>
            <Button Content="지금 업데이트" Command="{Binding UpdateCommand}" IsEnabled="{Binding CanUpdate}" Padding="14,4" FontWeight="SemiBold" Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
