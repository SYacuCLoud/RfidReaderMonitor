<Window x:Class="RfidReaderMonitor.Views.ModbusReaderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RfidReaderMonitor.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ModbusReaderEditorViewModel}"
        Title="{Binding Title}" Width="900" SizeToContent="Height" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Malgun Gothic" FontSize="12.5" Background="#F4F5F7">
    <Window.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 프리셋 -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="프리셋" Style="{StaticResource FormLabel}"/>
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Width="420"/>
            <TextBlock Text="{Binding SelectedPreset.Note}" Style="{StaticResource FormLabel}" Foreground="#666" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 폼 -->
        <StackPanel Grid.Row="1" Grid.Column="0">
            <GroupBox Header="연결">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="이름" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="이벤트·CSV·SQL 에 이 이름이 리더 이름으로 나갑니다. 비우면 호스트/유닛으로 만듭니다."/>
                    <TextBlock Grid.Row="1" Text="호스트" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="포트" Style="{StaticResource FormLabel}" Margin="10,0,8,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Text="Unit ID" Style="{StaticResource FormLabel}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="폴링(ms)" Style="{StaticResource FormLabel}" Margin="10,0,8,0"/>
                    <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding PollMs, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Content="사용 (끄면 목록에서 빠지고 설정만 남음)" IsChecked="{Binding Enabled}" Margin="0,4,0,0"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="태그 있음 (Present) 위치">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="영역" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ModbusReaderEditorViewModel.Areas}" SelectedItem="{Binding PresentArea}"/>
                    <TextBlock Grid.Column="2" Text="주소" Style="{StaticResource FormLabel}" Margin="10,0,8,0"/>
                    <TextBox Grid.Column="3" Text="{Binding PresentAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="비트" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" IsEnabled="{Binding PresentIsRegister}">
                        <TextBox Text="{Binding PresentBit, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <TextBlock Text="레지스터 영역일 때 0~15. -1 이면 레지스터 값이 0 이 아닐 때 있음으로 봅니다." Style="{StaticResource FormLabel}" Foreground="#666" Margin="10,0,0,0" TextWrapping="Wrap" Width="300"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="UID 위치">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="영역" Style="{StaticResource FormLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:ModbusReaderEditorViewModel.RegisterAreas}" SelectedItem="{Binding UidArea}"/>
                    <TextBlock Grid.Column="2" Text="시작 주소" Style="{StaticResource FormLabel}" Margin="10,0,8,0"/>
                    <TextBox Grid.Column="3" Text="{Binding UidAddress, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Text="길이(바이트)" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <TextBox Text="{Binding UidBytes, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <CheckBox Content="워드 안 바이트 스왑" IsChecked="{Binding UidSwapBytes}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <CheckBox Content="워드 역순" IsChecked="{Binding UidReverseWords}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="태그 규격" Style="{StaticResource FormLabel}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <ComboBox ItemsSource="{x:Static vm:ModbusReaderEditorViewModel.Families}" SelectedItem="{Binding TagFamily}" Width="140"/>
                        <TextBlock Text="ATR 이 없어 여기서 정합니다. 산업용 HF 는 대개 ISO 15693." Style="{StaticResource FormLabel}" Foreground="#666" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <TextBlock Text="주소는 모두 0 기준(PDU 주소)입니다. 장치 문서가 40001 식 1 기준이면 1을 빼서 넣으세요." Style="{StaticResource Label}" Foreground="#666" TextWrapping="Wrap" Margin="4,4,0,0"/>
        </StackPanel>

        <!-- 연결 테스트 -->
        <GroupBox Grid.Row="1" Grid.Column="2" Header="연결 테스트 (저장 전에 값 맞추기)">
            <StackPanel>
                <Button Content="{Binding TestButtonText}" Command="{Binding ToggleTestCommand}" HorizontalAlignment="Left" MinWidth="140" Margin="0,2,0,8"/>
                <TextBlock Text="{Binding TestLinkText}" Foreground="{Binding TestLinkColor}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding TestResponse}" Foreground="#888" Margin="0,0,0,8"/>

                <TextBlock Text="Present" Style="{StaticResource Head}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                    <Border CornerRadius="3" Padding="8,2" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#9E9E9E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TestPresent}" Value="True">
                                        <Setter Property="Background" Value="#2E7D32"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Foreground="White" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="없음"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TestPresent}" Value="True">
                                            <Setter Property="Text" Value="있음"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding TestPresentRaw}" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding TestBits}" FontFamily="Consolas" Foreground="#555" ToolTip="비트 15 … 비트 0. 태그를 놓았을 때 1 이 되는 자리가 Present 비트입니다."/>

                <TextBlock Text="UID 워드" Style="{StaticResource Head}" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding TestUidWords}" FontFamily="Consolas" TextWrapping="Wrap"/>
                <TextBlock Text="UID (해석)" Style="{StaticResource Head}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding TestUidBytes}" FontFamily="Consolas" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TestHint}" Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="태그를 리더에 놓고 Present 가 '있음'으로 바뀌는지, UID 가 E0 로 시작하는지 확인하세요. 폼 값을 바꾸면 다음 읽기부터 바로 반영됩니다."
                           Style="{StaticResource Label}" Foreground="#666" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 버튼 -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding ErrorText}" Foreground="#B03A2E" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="확인" Command="{Binding OkCommand}" MinWidth="90" IsDefault="True" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="취소" Command="{Binding CancelCommand}" MinWidth="80" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
