<Application x:Class="RfidReaderMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:readers="clr-namespace:RfidReaderMonitor.Readers"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 창들이 공유하는 기본 스타일 -->
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource Value}">
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="CopyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
        </Style>
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Content" Value="복사"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="72"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8,4,8,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderBrush" Value="#D8DBE0"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E6E8EC"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DBE0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- 상태 색상 -->
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Background" Value="#9AA0A6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static readers:PresenceState.Empty}">
                    <Setter Property="Background" Value="#8A94A6"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static readers:PresenceState.Present}">
                    <Setter Property="Background" Value="#2E9E5B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static readers:PresenceState.InUse}">
                    <Setter Property="Background" Value="#D98E04"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static readers:PresenceState.Mute}">
                    <Setter Property="Background" Value="#D98E04"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static readers:PresenceState.Unavailable}">
                    <Setter Property="Background" Value="#C43D3D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static readers:PresenceState.Removed}">
                    <Setter Property="Background" Value="#C43D3D"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="KindCell" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding KindText}" Value="등장">
                    <Setter Property="Foreground" Value="#1E7E45"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KindText}" Value="제거">
                    <Setter Property="Foreground" Value="#B03A2E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Application.Resources>
</Application>
